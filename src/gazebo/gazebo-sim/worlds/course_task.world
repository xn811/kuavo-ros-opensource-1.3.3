      <link name="ceiling_light">
        <pose>0.0000 0.0000 2.9000 0 0 0</pose>
        <light name="light" type="point">
          <pose>0 0 0 0 0 0</pose>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
          <attenuation>
            <range>20</range>
            <constant>0.5</constant>
            <linear>0.01</linear>
