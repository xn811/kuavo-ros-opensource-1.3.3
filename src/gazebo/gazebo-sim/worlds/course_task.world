<?xml version="1.0"?>
<sdf version="1.6">
  <world name="my_room_world">
    <!-- Link Attacher 插件 - 用于灵巧手吸附抓取 -->
    <!-- max_attach_distance: 最大吸附距离(米)，超过此距离无法吸附 -->
    <plugin name="link_attacher_plugin" filename="libgazebo_ros_link_attacher.so">
      <min_attach_distance>0.0</min_attach_distance>
      <max_attach_distance>0.25</max_attach_distance>
    </plugin>
    
    <include>
      <uri>model://sun</uri>
    </include>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="my_room">
      <static>true</static>
      <link name="floor">
        <pose>0.0000 0.0000 0.001 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box>
              <size>12.0000 12.0000 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>0.25 0.25 0.25 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="outer_wall_0_0">
        <pose>6.0000 0.0000 1.5000 0 0 -1.5708</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>12.0000 0.2000 3.0000</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>12.0000 0.2000 3.0000</size>
            </box>
          </geometry>
          <material>
            <ambient>0.08 0.08 0.1 1</ambient>
            <diffuse>0.12 0.12 0.15 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>

      <link name="outer_wall_1_0">
        <pose>0.0000 -6.0000 1.5000 0 0 3.1416</pose>
        <collision name="collision">
