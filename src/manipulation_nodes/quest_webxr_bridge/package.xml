<?xml version="1.0"?>
<package format="2">
  <name>quest_webxr_bridge</name>
  <version>0.1.0</version>
  <description>Non-invasive WebXR hand-tracking bridge for Kuavo arm IK and dexterous hands.</description>
  <maintainer email="maintainer@example.com">Kuavo integration team</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>rospy</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>std_srvs</build_depend>
  <build_depend>tf2_ros</build_depend>
  <build_depend>kuavo_msgs</build_depend>
  <build_depend>kuavo_ros_interfaces</build_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>rosnode</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>kuavo_msgs</exec_depend>
  <exec_depend>kuavo_ros_interfaces</exec_depend>
  <exec_depend>motion_capture_ik</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>rosbag</exec_depend>

  <export/>
</package>
