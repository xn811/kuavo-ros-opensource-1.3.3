{
    "ssh_config": {
        "hostname": "192.168.26.1",
        "port": 22,
        "username": "kuavo",
        "password": "leju_kuavo",
        "timeout": 30,
        "retry_count": 3,
        "retry_delay": 2
    },
    "default_container": "kuavo_gendexgrasp_staircase_estimation_dev",
    "commands": {
        "xhost_on": [
            "export DISPLAY=:1.0 && xhost +"
        ],
        "xhost_off": [
            "export DISPLAY=:1.0 && xhost -"
        ],
        "start_vision_system": [
            "cd /home/lab/vision_system",
            "source devel/setup.bash",
            "roslaunch stair_detection stair_detection.launch"
        ],
        "stop_vision_system": [
            "pkill -f stair_detection",
            "pkill -f roslaunch"
        ],
        "check_system_status": [
            "ps aux | grep ros",
            "top -n 1 | head -10"
        ]
    },

    "container-commands": {
        "run_staircase_detection": [
            "bash -c 'pkill -f terrain_runner'",
            "bash -c './leju_terrain_run.sh'"
        ],
        "start_staircase_detection": [
            "bash -c 'export DISPLAY=:1.0 && source devel/setup.bash && roslaunch vision_staircase_estimation one_start_all.launch'"
        ],
        "kill_staircase_detection": [
            "bash -c 'pkill -f terrain_runner'",
            "bash -c 'pkill -f ros'"
        ]
    },

    "file_transfer": {
        "upload_path": "/home/lab/uploaded_files",
        "download_path": "/home/lab/downloaded_files"
    }
} 
