<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="block">
  
  <!-- 引入apriltag宏 -->
  <xacro:include filename="$(find kuavo_assets)/models/apriltag/urdf/apriltag.xacro"/>
  
  <link name="world"/>
  
  <link name="base_link">
    <!-- 中空收纳盒参数: 外尺寸 0.3x0.2x0.15m, 壁厚 0.01m -->
    
    <!-- 底板 -->
    <visual>
      <geometry>
        <box size="0.3 0.2 0.01"/>
      </geometry>
      <origin xyz="0 0 -0.07" rpy="0 0 0"/>
      <material name="red">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.3 0.2 0.01"/>
      </geometry>
      <origin xyz="0 0 -0.07" rpy="0 0 0"/>
    </collision>

    <!-- 前墙 (y负方向) -->
    <visual>
      <geometry>
        <box size="0.3 0.01 0.15"/>
      </geometry>
      <origin xyz="0 -0.095 0" rpy="0 0 0"/>
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.3 0.01 0.15"/>
      </geometry>
      <origin xyz="0 -0.095 0" rpy="0 0 0"/>
    </collision>

    <!-- 后墙 (y正方向) -->
    <visual>
      <geometry>
        <box size="0.3 0.01 0.15"/>
      </geometry>
      <origin xyz="0 0.095 0" rpy="0 0 0"/>
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.3 0.01 0.15"/>
      </geometry>
      <origin xyz="0 0.095 0" rpy="0 0 0"/>
    </collision>

    <!-- 左墙 (x负方向) -->
    <visual>
      <geometry>
        <box size="0.01 0.18 0.15"/>
      </geometry>
      <origin xyz="-0.145 0 0" rpy="0 0 0"/>
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.01 0.18 0.15"/>
      </geometry>
      <origin xyz="-0.145 0 0" rpy="0 0 0"/>
    </collision>

    <!-- 右墙 (x正方向) -->
    <visual>
      <geometry>
        <box size="0.01 0.18 0.15"/>
      </geometry>
      <origin xyz="0.145 0 0" rpy="0 0 0"/>
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.01 0.18 0.15"/>
      </geometry>
      <origin xyz="0.145 0 0" rpy="0 0 0"/>
    </collision>

    <!-- 左耳 (保留原有设计) -->
    <visual>
      <geometry>
        <box size="0.1 0.15 0.025"/>
      </geometry>
      <origin xyz="-0.175 0.0 0.05" rpy="0 0 0"/>
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.1 0.15 0.025"/>
      </geometry>
      <origin xyz="-0.175 0.0 0.05" rpy="0 0 0"/>
    </collision>

    <!-- 右耳 (保留原有设计) -->
    <visual>
      <geometry>
        <box size="0.1 0.15 0.025"/>
      </geometry>
      <origin xyz="0.175 0.0 0.05" rpy="0 0 0"/>
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.1 0.15 0.025"/>
      </geometry>
      <origin xyz="0.175 0.0 0.05" rpy="0 0 0"/>
    </collision>

    <!-- 质量惯性 -->
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.0025" ixy="0" ixz="0" iyy="0.0025" iyz="0" izz="0.0025"/>
    </inertial>
  </link>

  <!-- Floating joint to make the block freely movable -->
  <joint name="floating" type="floating">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 -1.0 0.9" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo物理参数：增加摩擦力防止滑落 -->
  <gazebo reference="base_link">
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
  </gazebo>

  <!-- 在Block前面(Y负方向)贴上AprilTag ID=0 -->
  <!-- 二维码贴在前墙外表面，面向Y负方向 -->
  <!-- rpy: roll=0, pitch=90°(绕X轴立起来), yaw=180°(面向Y负方向) -->
  <xacro:apriltag_marker parent_link="base_link" id="0">
    <origin xyz="0 -0.101 0" rpy="1.5708 0 3.14159"/>
  </xacro:apriltag_marker>

</robot>
