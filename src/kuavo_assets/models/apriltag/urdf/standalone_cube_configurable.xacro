<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="standalone_apriltag_cube_configurable">
  
  <!-- 桌子基本参数 -->
  <xacro:property name="table_height" value="0.8" />
  <xacro:property name="table_thickness" value="0.04" />
  <xacro:property name="leg_radius" value="0.02" />
  
  <!-- 可配置的桌子位置参数 (通过xacro:arg传入) -->
  <!-- 桌子1: 物品拾取桌 -->
  <xacro:arg name="table1_x" default="0.0"/>
  <xacro:arg name="table1_y" default="-5.0"/>
  <xacro:arg name="table1_z" default="0.0"/>
  <xacro:arg name="table1_yaw" default="0.0"/>
  <!-- 桌子2: 放置桌A -->
  <xacro:arg name="table2_x" default="0.0"/>
  <xacro:arg name="table2_y" default="1.0"/>
  <xacro:arg name="table2_z" default="0.0"/>
  <xacro:arg name="table2_yaw" default="0.0"/>
  <!-- 桌子3: 放置桌B -->
  <xacro:arg name="table3_x" default="-2.0"/>
  <xacro:arg name="table3_y" default="1.0"/>
  <xacro:arg name="table3_z" default="0.0"/>
  <xacro:arg name="table3_yaw" default="0.0"/>
  <!-- 桌子4: 放置桌C -->
  <xacro:arg name="table4_x" default="2.0"/>
  <xacro:arg name="table4_y" default="1.0"/>
  <xacro:arg name="table4_z" default="0.0"/>
  <xacro:arg name="table4_yaw" default="0.0"/>
  
  <xacro:property name="t1_x" value="$(arg table1_x)"/>
  <xacro:property name="t1_y" value="$(arg table1_y)"/>
  <xacro:property name="t1_z" value="$(arg table1_z)"/>
  <xacro:property name="t1_yaw" value="$(arg table1_yaw)"/>
  <xacro:property name="t2_x" value="$(arg table2_x)"/>
  <xacro:property name="t2_y" value="$(arg table2_y)"/>
  <xacro:property name="t2_z" value="$(arg table2_z)"/>
  <xacro:property name="t2_yaw" value="$(arg table2_yaw)"/>
  <xacro:property name="t3_x" value="$(arg table3_x)"/>
  <xacro:property name="t3_y" value="$(arg table3_y)"/>
  <xacro:property name="t3_z" value="$(arg table3_z)"/>
  <xacro:property name="t3_yaw" value="$(arg table3_yaw)"/>
  <xacro:property name="t4_x" value="$(arg table4_x)"/>
  <xacro:property name="t4_y" value="$(arg table4_y)"/>
  <xacro:property name="t4_z" value="$(arg table4_z)"/>
  <xacro:property name="t4_yaw" value="$(arg table4_yaw)"/>
  
  <!-- 引入apriltag -->
  <xacro:include filename="$(find kuavo_assets)/models/apriltag/urdf/apriltag.xacro"/>
  
  <link name="world"/>
  
  <!-- 桌腿宏 (黑色金属材质) -->
  <xacro:macro name="table_leg" params="name">
    <link name="${name}">
      <visual>
        <geometry>
          <cylinder radius="${leg_radius}" length="${table_height}"/>
        </geometry>
        <material name="black_metal">
          <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${leg_radius}" length="${table_height}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.5"/>
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.001"/>
      </inertial>
    </link>
    <gazebo reference="${name}">
      <material>Gazebo/DarkGrey</material>
      <mu1>0.5</mu1>
      <mu2>0.5</mu2>
    </gazebo>
  </xacro:macro>
  
  <!-- 桌子宏 (cube_y_offset: 二维码相对桌子的y偏移, tyaw: 桌子朝向) -->
  <xacro:macro name="table_with_apriltag" params="prefix tx ty tz tyaw cube_y_offset tag_id">
    <!-- 桌面 (1.2m x 0.7m 长方形桌子, 黑色大理石材质) -->
    <link name="${prefix}_link">
      <visual>
        <geometry>
          <box size="1.2 0.7 ${table_thickness}"/>
        </geometry>
        <material name="black_marble">
          <color rgba="0.08 0.08 0.08 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="1.2 0.7 ${table_thickness}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="8.0"/>
        <inertia ixx="0.3" ixy="0" ixz="0" iyy="0.8" iyz="0" izz="1.0"/>
      </inertial>
    </link>
    
    <gazebo reference="${prefix}_link">
      <material>Gazebo/Black</material>
      <mu1>0.5</mu1>
      <mu2>0.5</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
    </gazebo>
    
    <joint name="world_to_${prefix}_joint" type="fixed">
      <parent link="world"/>
      <child link="${prefix}_link"/>
      <origin xyz="${tx} ${ty} ${table_height + tz}" rpy="0 0 ${tyaw}"/>
    </joint>
    
    <!-- 桌腿 -->
    <xacro:table_leg name="${prefix}_leg1"/>
    <xacro:table_leg name="${prefix}_leg2"/>
    <xacro:table_leg name="${prefix}_leg3"/>
    <xacro:table_leg name="${prefix}_leg4"/>
    
    <!-- 桌腿位置适应1.2x0.7m桌面 -->
    <joint name="${prefix}_to_leg1" type="fixed">
      <parent link="${prefix}_link"/>
      <child link="${prefix}_leg1"/>
      <origin xyz="0.5 0.25 ${-table_height/2}" rpy="0 0 0"/>
    </joint>
    <joint name="${prefix}_to_leg2" type="fixed">
      <parent link="${prefix}_link"/>
      <child link="${prefix}_leg2"/>
      <origin xyz="-0.5 0.25 ${-table_height/2}" rpy="0 0 0"/>
    </joint>
    <joint name="${prefix}_to_leg3" type="fixed">
      <parent link="${prefix}_link"/>
      <child link="${prefix}_leg3"/>
      <origin xyz="0.5 -0.25 ${-table_height/2}" rpy="0 0 0"/>
    </joint>
    <joint name="${prefix}_to_leg4" type="fixed">
      <parent link="${prefix}_link"/>
      <child link="${prefix}_leg4"/>
      <origin xyz="-0.5 -0.25 ${-table_height/2}" rpy="0 0 0"/>
    </joint>
    
    <!-- 二维码立方体 (y方向偏移-0.3米，与原始文件一致) -->
    <link name="${prefix}_cube">
      <visual>
        <geometry>
          <box size="0.1 0.1 0.1"/>
        </geometry>
        <material>
          <color rgba="0.8 0.8 0.8 0.5"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="0.1 0.1 0.1"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>
    
    <!-- 二维码位置需要根据桌子旋转计算 -->
    <joint name="world_to_${prefix}_cube" type="fixed">
      <parent link="world"/>
      <child link="${prefix}_cube"/>
      <origin xyz="${tx - cube_y_offset * sin(tyaw)} ${ty + cube_y_offset * cos(tyaw)} ${1.2 + tz}" rpy="0 0 ${tyaw}"/>
    </joint>
    
    <xacro:apriltag_marker parent_link="${prefix}_cube" id="${tag_id}">
      <origin xyz="0 0 0.05" rpy="1.5708 0 0"/>
    </xacro:apriltag_marker>
  </xacro:macro>
  
  <!-- 生成四张桌子 (二维码y偏移: 都在桌子y负方向-0.3，位置一致便于识别) -->
  <!-- 桌子1: 物品拾取桌, AprilTag ID=1 -->
  <xacro:table_with_apriltag prefix="table1" tx="${t1_x}" ty="${t1_y}" tz="${t1_z}" tyaw="${t1_yaw}" cube_y_offset="-0.3" tag_id="1"/>
  <!-- 桌子2: 放置桌A, AprilTag ID=2 -->
  <xacro:table_with_apriltag prefix="table2" tx="${t2_x}" ty="${t2_y}" tz="${t2_z}" tyaw="${t2_yaw}" cube_y_offset="-0.3" tag_id="2"/>
  <!-- 桌子3: 放置桌B, AprilTag ID=3 -->
  <xacro:table_with_apriltag prefix="table3" tx="${t3_x}" ty="${t3_y}" tz="${t3_z}" tyaw="${t3_yaw}" cube_y_offset="-0.3" tag_id="3"/>
  <!-- 桌子4: 放置桌C, AprilTag ID=4 -->
  <xacro:table_with_apriltag prefix="table4" tx="${t4_x}" ty="${t4_y}" tz="${t4_z}" tyaw="${t4_yaw}" cube_y_offset="-0.3" tag_id="4"/>

</robot>
