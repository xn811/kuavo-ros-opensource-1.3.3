<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  
  <!-- Livox 传感器宏 - 可挂载到任意 link -->
  <xacro:macro name="livox_sensor" params="link_name topic:='/livox/lidar' sensor_pose:='0 0 0.05 0 0 0' visualize:=false update_rate:=10 always_on:=false">
    
    <gazebo reference="${link_name}">
      <sensor type="ray" name="laser_livox_${link_name}">
        <pose>${sensor_pose}</pose>
        <visualize>${visualize}</visualize>
        <always_on>${always_on}</always_on>
        <update_rate>${update_rate}</update_rate>
        
        <plugin name="gazebo_ros_laser_controller" filename="liblivox_laser_simulation.so">
          <ray>
            <scan>
              <horizontal>
                <samples>100</samples>
                <resolution>1</resolution>
                <min_angle>-3.1415926535897931</min_angle>
                <max_angle>3.1415926535897931</max_angle>
              </horizontal>
              <vertical>
                <samples>50</samples>
                <resolution>1</resolution>
                <min_angle>-3.1415926535897931</min_angle>
                <max_angle>3.1415926535897931</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.1</min>
              <max>40</max>
              <resolution>1</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.0</stddev>
            </noise>
          </ray>
          <visualize>true</visualize>
          <samples>20000</samples>
          <downsample>1</downsample>
          <csv_file_name>mid360-real-centr.csv</csv_file_name>
          <publish_pointcloud_type>3</publish_pointcloud_type>
          <ros_topic>${topic}</ros_topic>
          <frameName>${link_name}</frameName>
        </plugin>
      </sensor>
    </gazebo>
    
  </xacro:macro>

</robot>