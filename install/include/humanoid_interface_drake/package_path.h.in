#pragma once

#include <cstddef>
#include <string>
#include <cstdlib>
#include <cassert>

namespace HighlyDynamic
{

  /** Gets the path to the package source directory. */
inline std::string getPath() {
#ifdef OPEN_SOURCE
  char* kuavo_ros_control_ws_install_path = std::getenv("KUAVO_ROS_CONTROL_WS_INSTALL_PATH");
  assert(kuavo_ros_control_ws_install_path != nullptr);
  return std::string(kuavo_ros_control_ws_install_path) + "@CATKIN_PACKAGE_SHARE_DESTINATION@";
#endif
  std::string path = "@PROJECT_SOURCE_DIR@";
  return path;
}

} // namespace HighlyDynamic
