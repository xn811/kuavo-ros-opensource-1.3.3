<?xml version="1.0" encoding="utf-8"?>
<robot name="right_arm_all"
  xmlns:xacro="http://wiki.ros.org/xacro"
  xmlns:drake="https://drake.mit.edu">

  <!-- right arm -->
  <!-- 并连杆解算不需要的部分 -->
  <xacro:if value="${is_parallel_solve==0}">
    <link name="r_arm_pitch">
      <inertial>
        <origin xyz="0.02420658 -0.12919906 -0.00011967" rpy="0 0 0"/>
        <mass value="0.91093645"/>
        <inertia ixx="0.00122338" ixy="-0.00292519" ixz="0.00000566" iyy="0.00121368" iyz="0.00001905" izz="0.01712013"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="../meshes/r_arm_pitch.obj"/>
        </geometry>
        <material name="">
          <color rgba="1 1 1 1"/>
        </material>
      </visual>
    </link>
    <joint name="r_arm_pitch" type="continuous">
      <origin xyz="-0.0174998525199999 -0.126 0.3145" rpy="0 0 0"/>
      <parent link="torso"/>
      <child link="r_arm_pitch"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.57" upper="1.57" effort="100" velocity="35" />
    </joint>
    <transmission type="SimpleTransmission">
      <joint name="r_arm_pitch"/>
      <actuator name="r_arm_pitch_motor"/>
    </transmission>

    <link name="r_arm_roll">
      <inertial>
        <origin xyz="-0.01120966 -0.00066742 -0.02268706" rpy="0 0 0"/>
        <mass value="0.08666791"/>
        <inertia ixx="0.00008601" ixy="0.00000108" ixz="0.00002335" iyy="0.00008984" iyz="0.00000090" izz="0.00005246"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="../meshes/r_arm_roll.obj"/>
        </geometry>
        <material name="">
          <color rgba="1 1 1 1"/>
        </material>
      </visual>
    </link>
    <joint name="r_arm_roll" type="continuous">
      <origin xyz="0.0638750000000006 -0.138475 0" rpy="0 0 0"/>
      <parent link="r_arm_pitch"/>
      <child link="r_arm_roll"/>
      <axis xyz="1 0 0"/>
      <limit lower="-1.57" upper="1.57" effort="100" velocity="35" />
    </joint>
    <transmission type="SimpleTransmission">
      <joint name="r_arm_roll"/>
      <actuator name="r_arm_roll_motor"/>
    </transmission>

    <link name="r_arm_yaw">
      <inertial>
        <origin xyz="-0.00004600 0.00226700 -0.08232700" rpy="0 0 0"/>
        <mass value="1.02924200"/>
        <inertia ixx="0.00314804" ixy="0.00000255" ixz="-0.00000604" iyy="0.00314241" iyz="-0.00012001" izz="0.00059701"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="../meshes/r_arm_yaw.obj"/>
        </geometry>
        <material name="">
          <color rgba="1 1 1 1"/>
        </material>
      </visual>
    </link>
    <joint name="r_arm_yaw" type="continuous">
      <origin xyz="-0.0436749999999998 0 -0.0497499999999998" rpy="0 0 0"/>
      <parent link="r_arm_roll"/>
      <child link="r_arm_yaw"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.57" upper="1.57" effort="100" velocity="35" />
    </joint>
    <transmission type="SimpleTransmission">
      <joint name="r_arm_yaw"/>
      <actuator name="r_arm_yaw_motor"/>
    </transmission>

    <link name="r_forearm_pitch">
      <inertial>
        <origin xyz="-0.01600470 -0.05786678 0.00000000" rpy="0 0 0"/>
        <mass value="0.10166658"/>
        <inertia ixx="0.00011514" ixy="0.00003460" ixz="0.00000000" iyy="0.00008482" iyz="0.00000000" izz="0.00012918"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="../meshes/r_forearm_pitch.obj"/>
        </geometry>
        <material name="">
          <color rgba="1 1 1 1"/>
        </material>
      </visual>
    </link>
    <joint name="r_forearm_pitch" type="continuous">
      <origin xyz="0 0.0302500000000003 -0.1377" rpy="0 0 0"/>
      <parent link="r_arm_yaw"/>
      <child link="r_forearm_pitch"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.57" upper="1.57" effort="100" velocity="35" />
    </joint>
    <transmission type="SimpleTransmission">
      <joint name="r_forearm_pitch"/>
      <actuator name="r_forearm_pitch_motor"/>
    </transmission>
  </xacro:if>

  <!-- 并连杆解算的基link名为baselink -->
  <xacro:if value="${is_parallel_solve==1}">
    <xacro:property name="base_link" value="base_link" />
  </xacro:if>
  <xacro:if value="${is_parallel_solve==0}">
    <xacro:property name="base_link" value="r_forearm_yaw" />
  </xacro:if>

  <link name="${base_link}">
    <inertial>
      <origin xyz="-0.00000976 0.00251867 -0.02250745" rpy="0 0 0"/>
      <mass value="0.47453309"/>
      <inertia ixx="0.00100031" ixy="0.00000014" ixz="-0.00000096" iyy="0.00098483" iyz="-0.00005175" izz="0.00030616"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/r_forearm_yaw.obj"/>
      </geometry>
      <material name="">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
  </link>
  <xacro:if value="${is_parallel_solve==0}">
    <joint name="r_forearm_yaw" type="continuous">
      <origin xyz="0 -0.0302500000000002 -0.0905499999999999" rpy="0 0 0"/>
      <parent link="r_forearm_pitch"/>
      <child link="r_forearm_yaw"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.57" upper="1.57" effort="100" velocity="35" />
    </joint>
    <transmission type="SimpleTransmission">
      <joint name="r_forearm_yaw"/>
      <actuator name="r_forearm_yaw_motor"/>
    </transmission>
  </xacro:if>
  <link name="r_hand_roll">
    <inertial>
      <origin xyz="-0.00001251 0.00378599 0.00001775" rpy="0 0 0"/>
      <mass value="0.02741561"/>
      <inertia ixx="0.00000392" ixy="0.00000000" ixz="0.00000000" iyy="0.00000355" iyz="0.00000000" izz="0.00000681"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/r_hand_roll.obj"/>
      </geometry>
      <material name="">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
  </link>
  <joint name="r_hand_roll" type="continuous">
    <origin xyz="-0.025322 0 -0.1575" rpy="0 0 0"/>
    <parent link="${base_link}"/>
    <child link="r_hand_roll"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="100" velocity="35" />
  </joint>
  <xacro:if value="${is_parallel==0}">
    <transmission type="SimpleTransmission">
      <joint name="r_hand_roll"/>
      <actuator name="r_hand_roll_motor"/>
    </transmission>
  </xacro:if>

  <link name="r_hand_pitch">
  <inertial>
    <origin xyz="0.00214702310217297 -7.83584216464961E-05 -0.0852818706514631" rpy="0 0 0"/>
    <mass value="0.6789"/>
    <inertia ixx="1.14121247582596E-05" ixy="1.76471512895622E-10" ixz="2.91544422581543E-07" iyy="1.11095803968485E-05" iyz="7.83308829804773E-10" izz="8.19797394000677E-06"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="../meshes/r_hand_pitch.obj"/>
    </geometry>
    <material name="">
      <color rgba="1 1 1 1"/>
    </material>
  </visual>
</link>

<joint name="r_hand_pitch" type="continuous">
  <origin xyz="0.02137 0 0" rpy="0 0 0"/>
  <parent link="r_hand_roll"/>
  <child link="r_hand_pitch"/>
  <axis xyz="0 1 0"/>
  <limit lower="-1.57" upper="1.57" effort="100" velocity="35" />
</joint>
<xacro:if value="${is_parallel==0}">
  <transmission type="SimpleTransmission">
    <joint name="r_hand_pitch"/>
    <actuator name="r_hand_pitch_motor"/>
  </transmission>
</xacro:if>

  <!-- 并连杆部分，用于并连杆解算以及可视化 -->
  <xacro:if value="${is_parallel==1}">
    <link name="r_r_arm_bar">
      <inertial>
        <origin xyz="-0.00554151967108991 0.00107110730201643 8.01148413552277E-05" rpy="0 0 0"/>
        <mass value="0.000933425431007405"/>
        <inertia ixx="1.38437799892514E-08" ixy="-5.67273704047732E-09" ixz="5.77606254446982E-10" iyy="6.06871256289307E-08" iyz="8.20102664432749E-11" izz="5.37887825241999E-08"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="../meshes/r_r_arm_bar.obj"/>
        </geometry>
        <material name="">
          <color rgba="1 1 1 1"/>
        </material>
      </visual>
    </link>
    <joint name="r_r_arm_bar" type="continuous">
      <origin xyz="0.0112999999984239 -0.024140000000002 -0.0759999999999971" rpy="0 0 0"/>
      <parent link="${base_link}"/>
      <child link="r_r_arm_bar"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.57" upper="1.57" effort="100" velocity="35" />
    </joint>
    <transmission type="SimpleTransmission">
      <joint name="r_r_arm_bar"/>
      <actuator name="r_r_arm_bar_motor"/>
      <drake:gear_ratio value="10.0" />
      <drake:rotor_inertia value="0.0001002" />
    </transmission>
    <frame link="r_r_arm_bar" name="r_r_arm_bar_frame" xyz="0 -0.0040000013363603 0" />
    <!-- add frame -->
    <link name="r_r_arm_tendon">
      <inertial>
        <origin xyz="-0.00765635531259815 0.000132036112088063 -0.0409092469907192" rpy="0 0 0"/>
        <mass value="0.00373178797597326"/>
        <inertia ixx="2.52754726727089E-06" ixy="7.66038091816824E-10" ixz="-4.64401938883845E-07" iyy="2.64294079486177E-06" iyz="4.31244533041838E-09" izz="1.33020958334864E-07"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="../meshes/r_r_arm_tendon.obj"/>
        </geometry>
        <material name="">
          <color rgba="1 1 1 1"/>
        </material>
      </visual>
    </link>
    <drake:joint name="r_r_arm_tendon" type="universal">
      <origin xyz="-0.0159983282022835 -0.0040000013363603 0.000231289282113974" rpy="0 0 0"/>
      <parent link="r_r_arm_bar"/>
      <child link="r_r_arm_tendon"/>
    </drake:joint>

    <link name="r_l_arm_bar">
      <inertial>
        <origin xyz="-0.00554152066507212 -0.00107110729779245 8.00460209587489E-05" rpy="0 0 0"/>
        <mass value="0.000933425428650283"/>
        <inertia ixx="1.38437660740365E-08" ixy="5.67273800803533E-09" ixz="5.77125012060783E-10" iyy="6.06871256776918E-08" iyz="-8.19431480269537E-11" izz="5.37887964707832E-08"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="../meshes/r_l_arm_bar.obj"/>
        </geometry>
        <material name="">
          <color rgba="1 1 1 1"/>
        </material>
      </visual>
    </link>
    <joint name="r_l_arm_bar" type="continuous">
      <origin xyz="0.0113000000048921 0.024139999999997 -0.1145" rpy="0 0 0"/>
      <parent link="${base_link}"/>
      <child link="r_l_arm_bar"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.57" upper="1.57" effort="100" velocity="35" />
    </joint>
    <transmission type="SimpleTransmission">
      <joint name="r_l_arm_bar"/>
      <actuator name="r_l_arm_bar_motor"/>
      <drake:gear_ratio value="10.0" />
      <drake:rotor_inertia value="0.0001002" />
    </transmission>
    <frame link="r_l_arm_bar" name="r_l_arm_bar_frame" xyz="0 0.0040000013363603 0" />
    <link name="r_l_arm_tendon">
      <inertial>
        <origin xyz="-0.00762999220333973 -0.000169588775282475 -0.0214971867253593" rpy="0 0 0"/>
        <mass value="0.0026624084343365"/>
        <inertia ixx="5.94886471341227E-07" ixy="-9.09725188142654E-10" ixz="-1.96376428049484E-07" iyy="6.92975761839731E-07" iyz="-1.78984774648677E-09" izz="1.1095058280343E-07"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="../meshes/r_l_arm_tendon.obj"/>
        </geometry>
        <material name="">
          <color rgba="1 1 1 1"/>
        </material>
      </visual>
    </link>
    <drake:joint name="r_l_arm_tendon" type="universal">
      <origin xyz="-0.0159983310229197 0.00400002806712421 0.000231094095741222" rpy="0 0 0"/>
      <parent link="r_l_arm_bar"/>
      <child link="r_l_arm_tendon"/>
    </drake:joint>
  </xacro:if>

  <xacro:if value="${is_parallel==1}">
    <!-- left arm constraint -->
    <frame link="r_l_arm_tendon" name="r_l_arm_tendon_socket" xyz="-0.01525 0.00014 -0.04299" />
    <frame link="r_r_arm_tendon" name="r_r_arm_tendon_socket" xyz="-0.01525 0.00014 -0.0815" />
  </xacro:if>

</robot>
